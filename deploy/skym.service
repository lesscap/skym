[Unit]
Description=skym agent: host and container checks, pushed to skym-server
Documentation=https://github.com/lesscap/skym
After=network-online.target docker.service
Wants=network-online.target

[Service]
User=skym
SupplementaryGroups=docker
ExecStart=/usr/local/bin/skym agent
StateDirectory=skym
ProtectSystem=strict
NoNewPrivileges=true
PrivateTmp=true
Restart=always
# A restart is a full first pass (every container, an hour of events): never more often
# than a normal pass, even if something keeps crashing.
RestartSec=60
# It runs on production hosts: never let it compete with the workloads it watches.
Nice=10
IOSchedulingClass=idle
CPUQuota=20%
MemoryMax=256M

[Install]
WantedBy=multi-user.target
